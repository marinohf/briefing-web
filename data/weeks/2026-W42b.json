name: Actualizar inteligencia
on:
  schedule:
    - cron: '30 5 * * *'   # cada día a las 05:30 UTC (07:30 en Madrid en verano)
  workflow_dispatch:
    inputs:
      mode:
        description: 'auto = lo que toque hoy; o fuerza daily / weekly / periods'
        default: auto
        type: choice
        options: [auto, daily, weekly, periods]
permissions:
  contents: write
concurrency:
  group: intel
  cancel-in-progress: false
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: Pruebas (sin red)
        run: node scripts/test.mjs
      - name: Generar contenido
        run: node scripts/run.mjs ${{ inputs.mode || 'auto' }}
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      - name: Publicar
        run: |
          git config user.name "intel-bot"
          git config user.email "intel-bot@users.noreply.github.com"
          git add data
          git diff --cached --quiet || (git commit -m "Actualización automática $(date -u +%F)" && git push)
